{
  "expo": {
    "name": "vitrinev0",
    "slug": "vitrinev0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "vitrine",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vitrine.app",
      "associatedDomains": ["applinks:myvitrine.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "Vitrine needs camera access to photograph your collectibles.",
        "NSPhotoLibraryUsageDescription": "Vitrine needs photo library access to upload images of your collectibles.",
        "NSPhotoLibraryAddUsageDescription": "Vitrine needs permission to save images to your photo library."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vitrine.app",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myvitrine.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
