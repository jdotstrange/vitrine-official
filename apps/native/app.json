{
  "expo": {
    "name": "MyVitrine",
    "slug": "myvitrine",
    "version": "3.0.0",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/e6910937-7d1c-4d59-9785-7b1d311a5378"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "vitrine",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020202"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vitrine",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:myvitrine.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "MyVitrine needs camera access to photograph your collectibles.",
        "NSPhotoLibraryUsageDescription": "MyVitrine needs photo library access to upload images of your collectibles.",
        "NSPhotoLibraryAddUsageDescription": "MyVitrine needs permission to save images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020202"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vitrine.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myvitrine.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#020202"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "myvitrine-llc"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6910937-7d1c-4d59-9785-7b1d311a5378"
      }
    },
    "owner": "jlocastostack"
  }
}
